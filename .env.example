# ─────────────────────────────────────────────────────────────────────────────
# SmartTrade Logistics Platform — .env.example
#
# INSTRUCTIONS
#   1. Copy this file:   cp .env.example .env
#   2. Fill in EVERY value marked !!!CHANGE_ME!!! with a real secret.
#   3. NEVER commit the .env file — it is in .gitignore.
#   4. For production, these secrets are managed by HashiCorp Vault.
#      See infrastructure/vault/README.md
#
# GENERATING STRONG RANDOM SECRETS (Linux/Mac/WSL):
#   openssl rand -base64 32        → 44-char base64 string
#   openssl rand -hex 32           → 64-char hex string
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════════
# VAULT (local dev only — dev mode uses a fixed root token)
# ═══════════════════════════════════════════════════════════════════════════════
# WARNING: This token is ONLY for docker-compose dev mode.
# Never use a fixed root token in staging or production.
VAULT_DEV_ROOT_TOKEN=!!!CHANGE_ME!!!


# ═══════════════════════════════════════════════════════════════════════════════
# JWT SIGNING
# ═══════════════════════════════════════════════════════════════════════════════
# Must be at least 32 UTF-8 bytes (use openssl rand -base64 32 to generate)
JWT_SECRET=!!!CHANGE_ME!!!
JWT_ISSUER=smart-trade
JWT_AUDIENCE=smart-trade-clients
JWT_LIFETIME_MINUTES=15


# ═══════════════════════════════════════════════════════════════════════════════
# DATABASES
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL (primary relational DB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=!!!CHANGE_ME!!!
POSTGRES_DB=smart_platform

# PostGIS (geospatial DB)
POSTGIS_USER=postgres
POSTGIS_PASSWORD=!!!CHANGE_ME!!!
POSTGIS_DB=smart_gis

# MongoDB (audit log, analytics)
MONGO_USER=root
MONGO_PASSWORD=!!!CHANGE_ME!!!

# Redis (caching, rate limiting, session)
REDIS_PASSWORD=!!!CHANGE_ME!!!


# ═══════════════════════════════════════════════════════════════════════════════
# MESSAGING
# ═══════════════════════════════════════════════════════════════════════════════
RABBITMQ_USER=smart_trade
RABBITMQ_PASSWORD=!!!CHANGE_ME!!!
RABBITMQ_VHOST=/smart_trade


# ═══════════════════════════════════════════════════════════════════════════════
# EXTERNAL APIS
# ═══════════════════════════════════════════════════════════════════════════════

# Stripe (payments)
STRIPE_SECRET_KEY=!!!CHANGE_ME!!!
STRIPE_WEBHOOK_SECRET=!!!CHANGE_ME!!!

# Twilio (SMS notifications)
TWILIO_ACCOUNT_SID=!!!CHANGE_ME!!!
TWILIO_AUTH_TOKEN=!!!CHANGE_ME!!!

# SendGrid (email notifications)
SENDGRID_API_KEY=!!!CHANGE_ME!!!

# Google Maps (fleet / routing)
GOOGLE_MAPS_API_KEY=!!!CHANGE_ME!!!

# AIS (vessel tracking)
AIS_API_KEY=!!!CHANGE_ME!!!

# ANPR / LPR (plate recognition)
ANPR_API_KEY=!!!CHANGE_ME!!!


# ═══════════════════════════════════════════════════════════════════════════════
# OBSERVABILITY
# ═══════════════════════════════════════════════════════════════════════════════
GRAFANA_ADMIN_PASSWORD=!!!CHANGE_ME!!!
JAEGER_AUTH_TOKEN=


# ═══════════════════════════════════════════════════════════════════════════════
# TESTING (CI / local integration tests only)
# ═══════════════════════════════════════════════════════════════════════════════
# Used by appsettings.Test.json — a static test-only JWT key.
# Must be at least 32 bytes.  NOT the same as JWT_SECRET.
JWT_SECRET_TEST=!!!CHANGE_ME!!!
K6_TEST_PASSWORD=Admin@123456!
