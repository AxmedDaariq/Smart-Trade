<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Declaration.IntegrationTests</AssemblyName>
    <RootNamespace>Declaration.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="3.8.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="..\Shared\Shared.IntegrationTests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\services\declaration\Declaration.Domain\Declaration.Domain.csproj" />
    <ProjectReference Include="..\..\..\services\declaration\Declaration.Contracts\Declaration.Contracts.csproj" />
    <ProjectReference Include="..\..\..\services\declaration\Declaration.Application\Declaration.Application.csproj" />
    <ProjectReference Include="..\..\..\services\declaration\Declaration.Infrastructure\Declaration.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\services\declaration\Declaration.Api\Declaration.Api.csproj" />
  </ItemGroup>

</Project>
