{
  "name": "smart-trade-logistics-e2e",
  "version": "1.0.0",
  "description": "Full-stack End-to-End tests for Smart Trade Logistics Platform - Frontend, Backend, Database, Mobile",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "cy:open":             "cypress open",
    "cy:run":              "cypress run",
    "cy:run:web":          "cypress run --spec \"cypress/e2e/frontend/**/*.cy.js,cypress/e2e/backend/**/*.cy.js\"",
    "cy:run:api":          "cypress run --spec \"cypress/e2e/backend/**/*.cy.js\"",
    "cy:run:db":           "cypress run --spec \"cypress/e2e/database/**/*.cy.js\"",
    "cy:run:mongo":        "cypress run --spec \"cypress/e2e/database/mongodb-telematics.cy.js\"",
    "cy:run:redis-rabbit": "cypress run --spec \"cypress/e2e/database/redis-rabbitmq-verification.cy.js\"",
    "cy:run:mobile":       "cypress run --spec \"cypress/e2e/mobile/**/*.cy.js\"",
    "cy:run:full":         "cypress run --spec \"cypress/e2e/full-stack/**/*.cy.js\"",
    "cy:report":           "npx mochawesome-merge cypress/reports/*.json -o cypress/reports/report.json && npx marge cypress/reports/report.json -f report -o cypress/reports",
    "cy:ci":               "cypress run --browser electron --headless --config video=false,screenshotOnRunFailure=true",
    "cy:ci:chrome":        "cypress run --browser chrome --headless --config video=false",
    "cy:ci:api":           "cypress run --browser electron --headless --spec \"cypress/e2e/backend/**/*.cy.js\"",
    "cy:verify":           "cypress verify",
    "cy:info":             "cypress info",
    "pretest":             "echo Ensure docker-compose services are running"
  },
  "devDependencies": {
    "cypress": "^16.2.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "cypress-real-events": "^1.15.1",
    "@cypress/grep": "^7.0.0",
    "pg": "^8.23.1",
    "mongodb": "^7.7.0",
    "ioredis": "^6.0.0",
    "amqplib": "^2.2.0",
    "axios": "^1.20.0"
  }
}